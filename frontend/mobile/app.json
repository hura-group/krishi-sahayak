{
  "expo": {
    "name": "KrishiSahayak",
    "slug": "krishi-sahayak",
    "version": "1.0.0",
    "main": "index.js",
    "scheme": "krishi-sahayak",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
